# Set these as Railway service variables. This file is documentation and is not loaded automatically.
DEBUG=False
SECRET_KEY=
SITE_DATA_DIR=/data
# Attach a persistent Railway volume to /data before filling the admin.
# DATABASE_URL=  # optional: external PostgreSQL instead of SQLite on the volume
# ALLOWED_HOSTS=your-domain.example
# CSRF_TRUSTED_ORIGINS=https://your-domain.example
# Optional Resend HTTPS API (works without outbound SMTP).
# Without RESEND_API_KEY the site uses FormSubmit: recipient in admin + email confirmation.
# Keep the key in Railway Variables, never in the public admin or Git.
RESEND_API_KEY=
# For a demo without a domain: onboarding@resend.dev, sending ONLY to the
# email used to register the Resend account. For production use a verified domain.
DEFAULT_FROM_EMAIL=
